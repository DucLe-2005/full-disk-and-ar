[Unit]
Description=Publish the current UTC solar flare forecast
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/flare-dashboard
ExecStart=/usr/bin/docker compose -f docker-compose.prod.yml run --no-deps --pull never --rm -T predictor --current-hour --attempts 3
TimeoutStartSec=50min
