# Set to a release published by CI.
IMAGE_TAG=v1.0.0
# Set this if deploying images from a fork or a different registry.
# IMAGE_PREFIX=ghcr.io/ducle-2005/full-disk-and-ar

POSTGRES_DB=flare_db
POSTGRES_USER=flare_user
# Generate a URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=

MINIO_ROOT_USER=flare_storage
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=solar-artifacts

# Bind to the host interface that should serve the dashboard.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
